{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "ClauDisk",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "Fabrizio Mazzei",
  "homepage_url": "https://claudisk-web.vercel.app",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "permissions": ["alarms", "storage", "offscreen", "cookies", "notifications"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claudeusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
